# AWS / Bedrock
# AWS_REGION is auto-provided by the Lambda runtime; set explicitly for local dev.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.7

# Bedrock embeddings (CV <-> job matching)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSION=512

# Supabase (job data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# S3 (CV storage)
S3_CV_BUCKET=joblab-cv-store

# MLflow tracking / tracing
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=joblab-ai-agent-production
MLFLOW_ACTIVE_MODEL_NAME=joblab-ai-agent

# Direct-DB fallback used when the MLflow REST server is unreachable.
# postgresql://user:pass@host:port/dbname
MLFLOW_TRACKING_URI_FALLBACK=
MLFLOW_DEFAULT_ARTIFACT_ROOT=

# MLflow Lite store-and-forward spool (S3-backed, used when tracking server is down)
MLFLOW_SPOOL_ENABLED=true
MLFLOW_SPOOL_BUCKET=
MLFLOW_SPOOL_PREFIX=mlflow-spool
MLFLOW_SPOOL_FLUSH_TOKEN=

# CORS
CORS_ORIGINS=http://localhost:3000
